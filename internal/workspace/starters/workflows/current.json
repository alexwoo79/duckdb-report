{
  "id": "demo-monthly",
  "name": "月度经营分析",
  "description": "导入销售明细，执行 SQL 聚合，并渲染为可预览的经营报告。",
  "runtime": {
    "title": "月度经营分析",
    "start_date": "2026-01-01",
    "end_date": "2026-12-31"
  },
  "presets": [
    {
      "id": "source-sales",
      "type": "datasource",
      "name": "销售明细 CSV",
      "description": "示例数据源，导入时会在工作库中重建 sales 表。",
      "params": {
        "kind": "csv",
        "path": "data/sales.csv",
        "table": "sales"
      }
    },
    {
      "id": "sql-monthly",
      "type": "sqlset",
      "name": "月度经营口径",
      "description": "按月份、区域与产品汇总收入、成本和毛利。",
      "params": {
        "mode": "file",
        "file": "sql/monthly_analysis.sql",
        "inline_sql": "",
        "query_file": "sql/monthly_result.sql",
        "limit": "500"
      }
    }
  ],
  "steps": [
    {
      "id": "import",
      "name": "导入销售明细",
      "kind": "import",
      "presetId": "source-sales",
      "enabled": true
    },
    {
      "id": "analyze",
      "name": "计算月度汇总",
      "kind": "sql",
      "presetId": "sql-monthly",
      "enabled": true
    }
  ]
}
